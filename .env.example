# Keep the real values in JADE_SECRETS_FILE; this file must never contain keys.
OPENAI_API_KEY=example
BOT_NAME=Jade
JADE_LLM_MODEL=gpt-6-luna
JADE_STT_MODEL=gpt-transcribe
JADE_TTS_MODEL=gpt-realtime-2.1-mini
# Étincelle voice profile (no pitch filter; private configuration takes precedence).
JADE_TTS_VOICE=shimmer
# Range: 0.25 to 1.5; use 1.0 for normal speed.
JADE_TTS_SPEED=1.25
# +2 semitones with FFmpeg Rubber Band (formants preserved); 0 disables.
# Requires an ffmpeg build with the optional rubberband filter.
# If unavailable, Jade keeps its original speech unchanged.
JADE_TTS_PITCH_SEMITONES=2.0
JADE_API_TIMEOUT=20
JADE_AUDIO_OUTPUT=none
# Experimental early LLM sentence -> TTS; leave disabled until listening validation.
JADE_EARLY_VOICE=0
JADE_SUBTITLE_PATH=subtitle.txt
JADE_HISTORY_LIMIT=24
JADE_QUEUE_LIMIT=64
JADE_RANDOM_REPLY_RATE=0
JADE_TWITCH_ENABLED=0
TWITCH_CHANNEL=example
TWITCH_TOKEN=example
# Optional: derive the bot login from a validated user token if blank.
TWITCH_BOT_LOGIN=
JADE_TWITCH_SEND=0
# Optional: requires a separately configured private GitHub backup.
JADE_TWITCH_AUTO_REFRESH=0
DISCORD_TOKEN=example
# Discord text: probability of joining an unaddressed question (0 = direct replies only).
JADE_DISCORD_TEXT_AUTO_RATE=0.30
# Minimum seconds between unsolicited responses per text channel (30-3600).
JADE_DISCORD_TEXT_COOLDOWN_SECONDS=180
# Historical activation/broadcast/participation fields are ignored; CLI selects services.
# JADE_DISCORD_ENABLED=0
# JADE_DISCORD_SEND=0
# JADE_DISCORD_VOICE_ENABLED=0
# JADE_DISCORD_VOICE_BROADCAST=0
# JADE_DISCORD_VOICE_ALLOWED_USERS=
# JADE_DISCORD_VOICE_CONSENT=0
DISCORD_VOICE_CHANNEL=0
JADE_VTS_ENABLED=0
JADE_VTS_TOKEN=example
JADE_VTS_URL=ws://127.0.0.1:8001
JADE_VTS_SPEAK_HOTKEY=
JADE_HTTP_ENABLED=0
# Generate a random 32+ byte local API token in the private secrets file.
JADE_HTTP_TOKEN=example
JADE_HTTP_PORT=8765

# Optional PUBLIC allowlisted profile; secrets still come from the private dotenv.
# JADE_PROFILE=offline
# JADE_PROFILE=fast-openai
# Or point to an explicit local non-secret profile:
# JADE_PROFILE_FILE=/outside-git/profiles/my-jade.toml
# Private persona and artwork can later move outside Git, without changing the code.
# JADE_PROMPT_FILE=/outside-git/prompt.txt
# JADE_ASSETS_ROOT=/outside-git/jade-assets
