# Keep the real values in JADE_SECRETS_FILE; this file must never contain keys.
OPENAI_API_KEY=example
BOT_NAME=Jade
JADE_LLM_MODEL=gpt-6-luna
JADE_STT_MODEL=gpt-transcribe
JADE_TTS_MODEL=gpt-realtime-2.1-mini
# Étincelle voice profile (no pitch filter; private configuration takes precedence).
JADE_TTS_VOICE=shimmer
# Range: 0.25 to 1.5; use 1.0 for normal speed.
JADE_TTS_SPEED=1.25
# +2 semitones with FFmpeg Rubber Band (formants preserved); 0 disables.
# Requires an ffmpeg build with the optional rubberband filter.
# If unavailable, Jade keeps its original speech unchanged.
JADE_TTS_PITCH_SEMITONES=2.0
JADE_API_TIMEOUT=20
# Opt-in anonymous timing stages per turn (queue, memory, LLM, delivery); no text.
JADE_LATENCY_LOG=0
JADE_AUDIO_OUTPUT=none
# Experimental early LLM sentence -> TTS; leave disabled until listening validation.
JADE_EARLY_VOICE=0
# Conversation Live mobile: enabled by default, independent of classic TTS.
# No mobile spending cap. Profile selects Live/classic; only a microphone gesture
# arms capture, and speech opens the provider session. Discord remains classic.
JADE_LIVE_ENABLED=1
JADE_MOBILE_LIVE_ENABLED=1
# Discord has one code switch: discord_config.py DISCORD_ENABLED (no env override).
JADE_LIVE_MODEL=gpt-live-1.1
# Aube is preferred, but has no verified public API ID. Brise is explicit fallback.
JADE_LIVE_VOICE=brise
JADE_LIVE_VOICE_ID=
# Optional session direction (friponne or petillante). Set the matching private voice ID.
JADE_LIVE_VOICE_STYLE=
JADE_LIVE_HEARTBEAT_SECONDS=2
JADE_LIVE_LEASE_SECONDS=5
JADE_LIVE_IDLE_STANDBY_SECONDS=8
JADE_LIVE_IDLE_CLOSE_SECONDS=30
JADE_LIVE_OPENING_TIMEOUT_SECONDS=8
JADE_LIVE_CLOSE_TIMEOUT_SECONDS=5
JADE_LIVE_MUTED_DRAIN_SECONDS=15
JADE_LIVE_MAX_SESSION_SECONDS=600
JADE_LIVE_MAX_STARTS_PER_MINUTE=3
JADE_LIVE_MAX_DELEGATIONS_PER_SESSION=12
# Optional absolute private paths outside Git; defaults live beside private Jade state.
JADE_LIVE_USAGE_DB_PATH=
JADE_LIVE_SESSION_DB_PATH=
JADE_SUBTITLE_PATH=subtitle.txt
JADE_HISTORY_LIMIT=24
JADE_QUEUE_LIMIT=64
JADE_RANDOM_REPLY_RATE=0
JADE_TWITCH_ENABLED=0
TWITCH_CHANNEL=example
TWITCH_TOKEN=example
# Optional: derive the bot login from a validated user token if blank.
TWITCH_BOT_LOGIN=
JADE_TWITCH_SEND=0
# Optional: requires a separately configured private GitHub backup.
JADE_TWITCH_AUTO_REFRESH=0
DISCORD_TOKEN=example
# Discord text: probability of joining an unaddressed question (0 = direct replies only).
JADE_DISCORD_TEXT_AUTO_RATE=0.20
# Discord voice: probability of spontaneous replies in a group.
JADE_DISCORD_VOICE_AUTO_RATE=0.20
# Minimum seconds between unsolicited responses per text channel (30-3600).
JADE_DISCORD_TEXT_COOLDOWN_SECONDS=180
# Historical private switches are ignored. discord_config.py DISCORD_ENABLED
# controls all CLI-selected Discord transports, including --all-channels.
# Automatic Live/classic selection reads global costs using the existing private
# JADE_OPENAI_ADMIN_KEY and configured Tavily account; missing data keeps classic.
# JADE_DISCORD_ENABLED=0
# JADE_DISCORD_SEND=0
# JADE_DISCORD_VOICE_ENABLED=0
# JADE_DISCORD_VOICE_BROADCAST=0
# JADE_DISCORD_VOICE_ALLOWED_USERS=
# JADE_DISCORD_VOICE_CONSENT=0
DISCORD_VOICE_CHANNEL=0
JADE_VTS_ENABLED=0
JADE_VTS_TOKEN=example
JADE_VTS_URL=ws://127.0.0.1:8001
JADE_VTS_SPEAK_HOTKEY=
JADE_HTTP_ENABLED=0
# Generate a random 32+ byte local API token in the private secrets file.
JADE_HTTP_TOKEN=example
JADE_HTTP_PORT=8765

# Optional PUBLIC allowlisted profile; secrets still come from the private dotenv.
# JADE_PROFILE=offline
# JADE_PROFILE=fast-openai
# Or point to an explicit local non-secret profile:
# JADE_PROFILE_FILE=/outside-git/profiles/my-jade.toml
# Private persona and artwork can later move outside Git, without changing the code.
# JADE_PROMPT_FILE=/outside-git/prompt.txt
# JADE_ASSETS_ROOT=/outside-git/jade-assets

# Live2D facial and text reactions to Reply.intent (PC and private mobile PWA).
# 0 disables ONLY avatar emotion, not voice prosody, Idle or lip-sync.
JADE_AVATAR_INTENT_ENABLED=1

# Optional path to a portable r21 PWA bundle with Jade.model3.json.
# Leave empty to use the tracked Jade v45.1 delivery (Git LFS files required).
JADE_MOBILE_SECOND_MODEL_DIR=

# DEV-032: private generated files, deleted after 24h (non-configurable).
# JADE_DOCUMENT_DIR=D:/Jade/private/jade-documents
# JADE_DOCUMENT_ACCESS_MODE=all
# Optional restrictions: owner or allowlist; all is the default.
# The PWA still requires its existing private mobile authentication.
# JADE_DOCUMENT_ALLOWED_DISCORD_IDS=

# DEV-036: optional Web Push to the owner's private Android PWA.
# Configure all three in JADE_SECRETS_FILE after generating a PRIVATE VAPID key.
# JADE_PUSH_VAPID_PUBLIC_KEY=
# JADE_PUSH_VAPID_PRIVATE_KEY=D:/Jade/private/jade-vapid-private.pem
# JADE_PUSH_VAPID_SUBJECT=mailto:contact@example.com
