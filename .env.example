# Keep the real values in JADE_SECRETS_FILE; this file must never contain keys.
OPENAI_API_KEY=example
BOT_NAME=Jade
JADE_LLM_MODEL=gpt-4.1-mini
JADE_STT_MODEL=gpt-4o-mini-transcribe
JADE_TTS_MODEL=gpt-4o-mini-tts
JADE_TTS_VOICE=coral
JADE_API_TIMEOUT=20
JADE_AUDIO_OUTPUT=none
JADE_SUBTITLE_PATH=subtitle.txt
JADE_HISTORY_LIMIT=24
JADE_QUEUE_LIMIT=64
JADE_RANDOM_REPLY_RATE=0
JADE_TWITCH_ENABLED=0
TWITCH_CHANNEL=example
TWITCH_TOKEN=example
TWITCH_BOT_LOGIN=example
JADE_TWITCH_SEND=0
JADE_DISCORD_ENABLED=0
DISCORD_TOKEN=example
JADE_DISCORD_SEND=0
JADE_DISCORD_VOICE_ENABLED=0
DISCORD_VOICE_CHANNEL=0
JADE_VTS_ENABLED=0
JADE_VTS_TOKEN=example
JADE_VTS_URL=ws://127.0.0.1:8001
JADE_VTS_SPEAK_HOTKEY=
JADE_HTTP_ENABLED=0
# Generate a random 32+ byte local API token in the private secrets file.
JADE_HTTP_TOKEN=example
JADE_HTTP_PORT=8765

# Optional PUBLIC allowlisted profile; secrets still come from the private dotenv.
# JADE_PROFILE=offline
# JADE_PROFILE=fast-openai
# Or point to an explicit local non-secret profile:
# JADE_PROFILE_FILE=/outside-git/profiles/my-jade.toml
# Private persona and artwork can later move outside Git, without changing the code.
# JADE_PROMPT_FILE=/outside-git/prompt.txt
# JADE_ASSETS_ROOT=/outside-git/jade-assets
